# WA/D - Wisdom Assistor/Distributor Configuration
# Copy this file to .env and fill in your API keys

# ── API Keys (configure at least one) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MICROSOFT_API_KEY=

# ── Model Selection ──
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_MODEL=gemini-1.5-pro

# ── Server ──
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ── Screen Capture ──
CAPTURE_INTERVAL=2.0
OCR_ENABLED=true

# ── Safety ──
AUTOMATION_ENABLED=false
REQUIRE_PERMISSION_FOR_ACTIONS=true

# ── Memory ──
MAX_MEMORY_ENTRIES=1000
# DB_PATH=  # Leave empty for default (~/.wad/wad_memory.db)
